---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClothoStudio from './ClothoStudio';
import '@kokoa/clotho-editor/styles.css';
---

<BaseLayout
  title="Clotho Editor (dev)"
  description="개발 환경 전용 애니메이션 편집기"
  noIndex
  hideFooter
>
  <ClothoStudio client:only="react" />
</BaseLayout>

<style is:global>
  .studio-shell {
    height: calc(100dvh - 4rem);
    min-height: 0;
  }
</style>
